# Server-side configuration only. Do not rename these to VITE_* variables.
# Use JSON array syntax so codes can safely contain punctuation.
ACCESS_CODES=["replace-with-a-long-random-code-1","replace-with-a-long-random-code-2"]
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Azure AI Foundry connection values used only by the server-side API.
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_AGENT_NAME=your-agent-name
AZURE_AI_AGENT_VERSION=1

# Service principal used by the server-side API to authenticate with Azure.
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-application-client-id
AZURE_CLIENT_SECRET=replace-with-a-secret
